#include <iostream>

int reverterNumero(int numero) {
    int numeroReverso = 0;
    while (numero > 0) {
        int ultimoDigito = numero % 10;
        numeroReverso = (numeroReverso * 10) + ultimoDigito;
        numero /= 10;
    }
    return numeroReverso;
}

long long calcularFatorial(int n) {
    if (n < 0) return 0;
    long long fatorial = 1;
    for (int i = 1; i <= n; i++) {
        fatorial *= i;
    }
    return fatorial;
}

bool verificarPrimo(int numero) {
    if (numero <= 1) return false;
    for (int i = 2; i * i <= numero; i++) {
        if (numero % i == 0) return false;
    }
    return true;
}

int main() {
    int opcao = 0;

    do {
        std::cout << "       MENU DE EXERCICIOS     \n";
        std::cout << "1 - Inverter um Numero\n";
        std::cout << "2 - Calcular Fatorial\n";
        std::cout << "3 - Verificar se o Numero eh Primo\n";
        std::cout << "4 - Sair\n";
        std::cout << "Escolha uma opcao: ";
        std::cin >> opcao;

        switch (opcao) {
            case 1: {
                int num;
                std::cout << "\n[Opcao 1] Digite um numero para inverter: ";
                std::cin >> num;
                std::cout << "Resultado: " << reverterNumero(num) << "\n";
                break;
            }
            case 2: {
                int num;
                std::cout << "\n[Opcao 2] Digite um numero para calcular o fatorial: ";
                std::cin >> num;
                std::cout << "Fatorial de " << num << " eh: " << calcularFatorial(num) << "\n";
                break;
            }
            case 3: {
                int num;
                std::cout << "\n[Opcao 3] Digite um numero para verificar se eh primo: ";
                std::cin >> num;
                if (verificarPrimo(num)) {
                    std::cout << num << " eh um numero PRIMO.\n";
                } else {
                    std::cout << num << " NAO eh um numero primo.\n";
                }
                break;
            }
            case 4:
                std::cout << "\nSaindo do programa...\n";
                break;
            default:
                std::cout << "\nOpcao invalida! Tente novamente.\n";
        }
    } while (opcao != 4);

    return 0;
}